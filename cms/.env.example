# PostgreSQL 17. En local, Laragon 17.5 en 127.0.0.1:5432.
# En esta máquina la autenticación local es trust: no hace falta clave.
# En Coolify, la URI la da el contenedor de Postgres e incluye la clave.
DATABASE_URI=postgresql://postgres@127.0.0.1:5432/manejoweb

# Secreto para firmar sesiones. En local puede ser cualquiera; en Coolify, uno largo.
PAYLOAD_SECRET=cambiar-este-secreto

# URL pública del admin y de la API.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# MariaDB del admin PHP. Solo la usa `npm run export:mariadb`.
# La clave de producción no va acá. En Laragon local el root no tiene clave.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=u568255035_manejoweb
MARIADB_ROOT=C:\laragon\www\manejoweb

# Clave temporal de los usuarios importados. El hash de PHP no sirve en Payload.
# Este valor es un placeholder. La clave real va solo en .env.
CMS_IMPORT_PASSWORD=cambiar-esta-clave

# Webhooks de Cloudflare. Si están vacíos, guardar igual funciona y solo se registra.
# No pongas URLs reales en el ejemplo.
CLOUDFLARE_DEPLOY_HOOK_WEB=
CLOUDFLARE_DEPLOY_HOOK_PORTFOLIO=

# Orígenes extra, separados por coma. Los de producción y localhost ya están en el código.
# CORS_ORIGINS=https://preview.ejemplo.com
