# Local: SQLite. Payload 3 no soporta MariaDB. No hace falta Postgres en esta máquina.
# El archivo queda en cms/manejoweb.db y no se versiona.
DATABASE_URI=file:./manejoweb.db

# Secreto para firmar sesiones. En local puede ser cualquiera; en Coolify, uno largo.
PAYLOAD_SECRET=cambiar-este-secreto

# URL pública del admin y de la API.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Admin que crea el seed la primera vez que arranca el CMS local.
# El valor de acá es un placeholder. La clave real va solo en .env.
CMS_ADMIN_EMAIL=admin@manejoweb.local
CMS_ADMIN_PASSWORD=cambiar-esta-clave

# Coolify (Postgres 17). Reemplazá DATABASE_URI y la URL. No uses file:.
# DATABASE_URI=postgresql://USUARIO:CLAVE@HOST:5432/NOMBRE
# NEXT_PUBLIC_SERVER_URL=https://admin.manejoweb.com.ar

# Orígenes extra, separados por coma. Los de producción y localhost ya están en el código.
# CORS_ORIGINS=https://preview.ejemplo.com
