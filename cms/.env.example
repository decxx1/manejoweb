# Postgres 17 externo. En Coolify, la base se crea aparte y se pasa por esta variable.
# La base tiene que existir: el CMS no la crea.
# postgresql://USUARIO:CLAVE@HOST:5432/NOMBRE
DATABASE_URI=

# Secreto para firmar sesiones. Generar uno largo, por ejemplo: openssl rand -base64 36
PAYLOAD_SECRET=

# URL pública del admin y de la API.
NEXT_PUBLIC_SERVER_URL=https://admin.manejoweb.com.ar

# Orígenes extra, separados por coma. Los de producción y localhost ya están en el código.
# CORS_ORIGINS=https://preview.ejemplo.com
